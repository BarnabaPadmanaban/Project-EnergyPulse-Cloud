# EnergyPulse Cloud Configuration
# Set DEMO_MODE=True to run locally with sample/cached data without GCP credentials
DEMO_MODE=True

# Google Cloud Platform Settings (Required only when DEMO_MODE=False)
GCP_PROJECT_ID=energypulse-cloud-dev
GCP_REGION=us-central1
GCS_BUCKET_NAME=energypulse-raw-data-bucket
BQ_DATASET_ID=energypulse_analytics
BQ_TABLE_ID=household_hourly_consumption

# Optional Service Account Key Path (If not using ADC / gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
